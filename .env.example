# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Mot de passe du super admin (seed / bootstrap)
BOOTSTRAP_ADMIN_PASSWORD=admin123!
BOOTSTRAP_ADMIN_PHONE=+2290140942258

# Fichiers locaux (fallback si pas de MongoDB)
DATA_DIR=./data

# MongoDB Atlas (requis en production)
# 1) Créez un cluster Free M0 sur https://cloud.mongodb.com
# 2) Database Access → user + password
# 3) Network Access → Add IP (0.0.0.0/0 pour commencer, ou votre IP)
# 4) Connect → Drivers → copiez l'URI
# Exemple:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=solidarite_plus
